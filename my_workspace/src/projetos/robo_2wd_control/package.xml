<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robo_2wd_control</name>
  <version>0.1.0</version>
  <description>
    Controle completo do Robô Móvel 2WD (Real com ESP32/Arduino via micro-ROS e Simulação Gazebo/URDF).
  </description>
  <maintainer email="lipecs.1111@gmail.com">filipe</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclcpp: framework C++ do ROS2 -->
  <depend>rclcpp</depend>
  <!-- std_msgs: fornece std_msgs/msg/Int32 -->
  <depend>std_msgs</depend>
  <!-- geometry_msgs: fornece geometry_msgs/msg/Twist para controle de movimento -->
  <depend>geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
